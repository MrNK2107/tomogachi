# ===============================================
# AWAKEN - Configuration
# ===============================================

# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your Personal Telegram Chat ID
# (Leave blank or auto-populated when you send /start in Telegram)
TELEGRAM_CHAT_ID=

# -----------------------------------------------
# CLOUD DEPLOYMENT SETTINGS
# -----------------------------------------------
# When deployed to Render, paste your Render app URL here:
# Example: https://awaken-sentinel.onrender.com
CLOUD_SERVER_URL=

# Secret shared between your laptop and cloud server to secure heartbeats
HEARTBEAT_SECRET=awaken-secret-key-2026

# How often (in seconds) the laptop sends heartbeats to the cloud
HEARTBEAT_INTERVAL_SECONDS=60

# Inactivity / sleep threshold (in minutes) before triggering an away alert or offline roast
IDLE_THRESHOLD_MINUTES=15
OFFLINE_ASLEEP_THRESHOLD_MINUTES=15

# Interval (in minutes) between follow-up reminders while still away or asleep
REMINDER_INTERVAL_MINUTES=25

# Maximum number of follow-up reminders to send while away (prevents infinite spam)
MAX_AWAY_REMINDERS=3

# How frequently (in seconds) the sentinel checks input activity
CHECK_INTERVAL_SECONDS=5
